NODE_ENV=development
PORT=3000

# ─── Database: pick ONE method ──────────────────────────────────────────────

# Option A — full connection URL (Supabase, Railway, Neon, etc.)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — individual fields (local Docker or EC2 Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=buspoint

# Shared options (apply to both methods)
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_STATEMENT_TIMEOUT_MS=30000

# Never true in production
DB_SYNC=false
DB_LOGGING=false

# ─── App ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

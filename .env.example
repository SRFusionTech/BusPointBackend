# ─────────────────────────────────────────────────────────────────────────────
# BusPoint API — SRFusion
# Copy this file to .env and fill in your values.
# Keys marked [ACTIVE] are used now. Keys marked [FUTURE] are wired but not
# enabled yet — uncomment as each feature is built.
# ─────────────────────────────────────────────────────────────────────────────

# ─── App [ACTIVE] ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3010,http://localhost:8081

# ─── Database [ACTIVE] — pick ONE method ─────────────────────────────────────

# Option A — full URL (Supabase, Railway, Neon, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:5432/buspoint

# Option B — individual fields (local / EC2)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=buspoint

# Shared pool settings
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECT_TIMEOUT_MS=10000
DB_ACQUIRE_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_STATEMENT_TIMEOUT_MS=30000

# Never true in production
DB_SYNC=false
DB_LOGGING=false

# ─── JWT [ACTIVE] ────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# ─── Super admin seed [ACTIVE] ───────────────────────────────────────────────
# Runs once on startup — creates super admin if not exists (idempotent)
SUPER_ADMIN_EMAIL=admin@srfusiontech.com
SUPER_ADMIN_PASSWORD=ChangeMe@123

# ─── Redis [FUTURE] — needed for Socket.IO scaling + BullMQ jobs ─────────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── Socket.IO [FUTURE] ──────────────────────────────────────────────────────
# SOCKET_CORS_ORIGINS=http://localhost:3010
# SOCKET_JWT_SECRET=   # defaults to JWT_SECRET if not set

# ─── Firebase [FUTURE] — FCM push notifications only ─────────────────────────
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# (or) GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-adminsdk.json

# ─── SMS / OTP [FUTURE] ──────────────────────────────────────────────────────
# OTP_PROVIDER=fast2sms         # fast2sms | twilio | mock
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# OTP_EXPIRY_SECONDS=300
# OTP_RATE_LIMIT_PER_HOUR=5

# ─── Email [FUTURE] ──────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@srfusiontech.com

# ─── Subscriptions / Payments [FUTURE] ───────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ─── Storage [FUTURE] — bus icons, profile photos ────────────────────────────
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CDN_URL=

# ─── Monitoring [FUTURE] ─────────────────────────────────────────────────────
# SENTRY_DSN=
# LOG_LEVEL=log             # error | warn | log | debug | verbose

# Road-following trip paths come from OSRM (free). Optional self-hosted server:
# OSRM_URL=https://router.project-osrm.org
# Optional PAID fallback (Google Routes API) used only when OSRM fails:
# GOOGLE_MAPS_SERVER_KEY=

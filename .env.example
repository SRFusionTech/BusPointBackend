# Backend environment example
# Copy this file to .env and customize values.

PORT=3000
NODE_ENV=development

# IMPORTANT: Keep this false for persistent Postgres data.
# FIRESTORE=true uses in-memory SQLite and data is lost on restart.
FIRESTORE=false

# Database safety guards
# DB_SYNC=true lets TypeORM change schema automatically.
# Keep false in normal/dev/prod usage to avoid accidental schema changes.
DB_SYNC=false
# Never enable unless you intentionally want to drop all DB tables at startup.
DB_DROP_SCHEMA=false

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=buspoint
# Optional: override host/port/user/pass/db with a full URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buspoint
# For Supabase, paste your pooled connection string here instead:
# SUPABASE_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# MongoDB (optional — notifications only; core data is Supabase/Postgres)
# Leave unset to run without Mongo. Set to enable /api/notifications storage.
# MONGO_URI=mongodb://localhost:27017/buspoint
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=BusPoint

# JWT
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=7d

# CORS: comma-separated origins
# Example: http://localhost:3010,http://localhost:3020,http://localhost:3030
CORS_ORIGINS=http://localhost:3010,http://localhost:3020,http://localhost:3030

# Super admin (optional)
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_JWT_SECRET=superadmin-secret
SUPER_ADMIN_PASSWORD_HASH=

# SMS OTP (Fast2SMS). Leave blank in local dev to print OTP in server logs.
# FAST2SMS_API_KEY=

# Firebase admin (optional — required for Google/Facebook login)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Production (Railway) must set at minimum:
# NODE_ENV=production
# JWT_SECRET=<secure-random>
# SUPABASE_DATABASE_URL= or DATABASE_URL=
# FAST2SMS_API_KEY=
# FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
# CORS_ORIGINS=https://your-landing.vercel.app
